{
  "name": "district-builder-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "check-format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/server/src/main",
    "lint": "eslint 'src/**/*.{ts,tsx,json}'",
    "fix": "eslint 'src/**/*.{ts,tsx,json}' --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "migration:generate": "yarn run typeorm migration:generate",
    "migration:create": "yarn run typeorm migration:create",
    "migration:revert": "yarn run typeorm migration:revert",
    "migration:run": "ts-node -r tsconfig-paths/register src/commands/run-migrations.ts",
    "migration:dsql-check": "ts-node -r tsconfig-paths/register src/commands/transform-migration-for-dsql.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.840.0",
    "@aws-sdk/client-ses": "3.840.0",
    "@aws-sdk/dsql-signer": "^3",
    "@dataui/crud": "5.3.4",
    "@dataui/crud-typeorm": "5.3.4",
    "@drdgvhbh/postgres-error-codes": "0.0.6",
    "@nestjs-modules/mailer": "2.3.4",
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.17",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/typeorm": "11.0.0",
    "@turf/area": "6.5.0",
    "@turf/bbox": "6.5.0",
    "@turf/length": "6.5.0",
    "@turf/polygon-to-line": "6.5.0",
    "axios": "1.13.6",
    "base64url": "3.0.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "csv-parse": "4.15.3",
    "csv-stringify": "5.5.1",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "form-data": "4.0.5",
    "handlebars": "4.7.8",
    "lodash": "4.17.21",
    "nestjs-typeorm-paginate": "4.1.0",
    "nodemailer": "6.10.1",
    "object-sizeof": "2.6.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "promise-queue": "2.2.5",
    "pug": "3.0.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.17",
    "@types/bcrypt": "5.0.0",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/inline-css": "3.0.4",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.24",
    "@types/multer": "1.4.7",
    "@types/node": "24.0.3",
    "@types/nodemailer": "6.4.17",
    "@types/passport-jwt": "4.0.1",
    "@types/promise-queue": "2.2.3",
    "@types/pug": "2.0.10",
    "@types/supertest": "6.0.2",
    "@types/topojson-client": "3.1.5",
    "@types/uuid": "^10.0.0",
    "@types/validator": "13.15.10",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "7.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "50.6.17",
    "eslint-plugin-local-rules": "3.0.2",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
