                ('FL', 'U.S. House', 28), ('GA', 'U.S. House', 14),
                ('HI', 'U.S. House', 2), ('ID', 'U.S. House', 2),
                ('IL', 'U.S. House', 17), ('IN', 'U.S. House', 9),
                ('IA', 'U.S. House', 4), ('KS', 'U.S. House', 4),
                ('KY', 'U.S. House', 6), ('LA', 'U.S. House', 6),
