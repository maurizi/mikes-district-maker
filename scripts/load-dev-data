                ('WY', 'House of Representatives', 62)
              ) AS c(code, name, districts) ON rc.region_code = c.code
              ON CONFLICT DO NOTHING;
            "

        # Set number_of_members for multi-member district chambers
        docker compose \
            exec database psql -U districtbuilder districtbuilder -c "
              -- Multi-member lower chambers (2 per district)
              UPDATE chamber SET number_of_members = array_fill(2, ARRAY[number_of_districts])
              WHERE name IN ('House of Representatives', 'House of Delegates', 'General Assembly', 'State Assembly')
                AND region_config_id IN (
                  SELECT id FROM region_config WHERE region_code IN ('AZ','ID','ND','NJ','SD','WA')
                  AND hidden = false AND archived = false
                );
              -- Maryland House of Delegates: 3 per district
              UPDATE chamber SET number_of_members = array_fill(3, ARRAY[number_of_districts])
              WHERE name = 'House of Delegates'
                AND region_config_id IN (
                  SELECT id FROM region_config WHERE region_code = 'MD'
                  AND hidden = false AND archived = false
                );
              -- West Virginia Senate: 2 per district
              UPDATE chamber SET number_of_members = array_fill(2, ARRAY[number_of_districts])
              WHERE name = 'Senate'
                AND region_config_id IN (
                  SELECT id FROM region_config WHERE region_code = 'WV'
                  AND hidden = false AND archived = false
                );
            "

        echo "Loaded chambers"
