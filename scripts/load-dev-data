              ON CONFLICT (country_code, region_code) WHERE hidden <> true AND archived <> true DO UPDATE SET
                name = EXCLUDED.name,
                s3_uri = EXCLUDED.s3_uri,
                version = EXCLUDED.version;
            "

        echo "Loaded 51 region configs"

        # Load chambers for all states
        # Uses a helper script to generate chamber SQL from region_config IDs
        echo "Loading chambers..."
        docker compose \
            exec database psql -U districtbuilder districtbuilder -c "
              -- Delete existing chambers to avoid duplicates
              DELETE FROM chamber WHERE id NOT IN (SELECT DISTINCT chamber_id FROM project WHERE chamber_id IS NOT NULL)
                AND id NOT IN (SELECT DISTINCT chamber_id FROM project_template WHERE chamber_id IS NOT NULL);

              -- Insert US House + state legislature chambers for each state
              -- Using a CTE to look up region_config IDs by region_code
              WITH rc AS (
                SELECT id, region_code FROM region_config
                WHERE hidden = false AND archived = false
              )
              INSERT INTO chamber (name, number_of_districts, region_config_id)
              SELECT name, districts, rc.id FROM rc JOIN (VALUES
                -- US House of Representatives (2020 apportionment)
                ('AL', 'U.S. House', 7), ('AK', 'U.S. House', 1),
                ('AZ', 'U.S. House', 9), ('AR', 'U.S. House', 4),
                ('CA', 'U.S. House', 52), ('CO', 'U.S. House', 8),
