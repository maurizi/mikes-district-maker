                ('MA', 'U.S. House', 9), ('MI', 'U.S. House', 13),
                ('MN', 'U.S. House', 8), ('MS', 'U.S. House', 4),
                ('MO', 'U.S. House', 8), ('MT', 'U.S. House', 2),
                ('NE', 'U.S. House', 3), ('NV', 'U.S. House', 4),
                ('NH', 'U.S. House', 2), ('NJ', 'U.S. House', 12),
                ('NM', 'U.S. House', 3), ('NY', 'U.S. House', 26),
                ('NC', 'U.S. House', 14), ('ND', 'U.S. House', 1),
                ('OH', 'U.S. House', 15), ('OK', 'U.S. House', 5),
                ('OR', 'U.S. House', 6), ('PA', 'U.S. House', 17),
                ('RI', 'U.S. House', 2), ('SC', 'U.S. House', 7),
                ('SD', 'U.S. House', 1), ('TN', 'U.S. House', 9),
                ('TX', 'U.S. House', 38), ('UT', 'U.S. House', 4),
