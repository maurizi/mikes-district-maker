{
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "module": "commonjs",
    "outDir": "lib",
    "rootDirs": ["src", "../"],
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2022",
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
