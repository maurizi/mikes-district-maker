                ('PA', 'State Senate', 50), ('RI', 'Senate', 38),
                ('SC', 'Senate', 46), ('SD', 'Senate', 35),
                ('TN', 'Senate', 33), ('TX', 'Senate', 31),
                ('UT', 'State Senate', 29), ('VA', 'Senate', 40),
                ('VT', 'Senate', 13), -- Multi-member: 30 seats across 13 districts
                ('WA', 'State Senate', 49), ('WV', 'Senate', 17), -- 34 seats, 2 per district
                ('WI', 'Senate', 33), ('WY', 'Senate', 31),

                -- State House / Lower Chamber (skip Nebraska - unicameral)
                ('AL', 'House of Representatives', 105),
                ('AK', 'House of Representatives', 40),
                ('AZ', 'House of Representatives', 30), -- 60 seats, 2 per district
                ('AR', 'House of Representatives', 100),
