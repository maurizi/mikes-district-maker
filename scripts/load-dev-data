#!/bin/bash

set -e

if [[ -n "${DB_DEBUG}" ]]; then
    set -x
fi

function usage() {
    echo -n \
        "Usage: $(basename "$0")
Load all 51 state region configs for development purposes.

This loads region configs pointing to processed VEST election data
on S3 for all 50 states + DC, with 2016/2018/2020 voting data.
"
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    if [ "${1:-}" = "--help" ]; then
        usage
    else
        # Bring up PostgreSQL
        docker compose \
            -f docker-compose.yml \
            up -d database

        # Wait for database to be ready
        echo "Waiting for database..."
        sleep 3

        # Upsert all 51 state region configs
        echo "Loading region configs..."
        docker compose \
            exec database psql -U districtbuilder districtbuilder -c "
              INSERT INTO region_config (name, country_code, region_code, s3_uri, version)
              VALUES
