                ('AL', 'Senate', 35), ('AK', 'Senate', 20),
                ('AZ', 'Senate', 30), ('AR', 'Senate', 35),
                ('CA', 'State Senate', 40), ('CO', 'Senate', 35),
                ('CT', 'State Senate', 36), ('DE', 'Senate', 21),
